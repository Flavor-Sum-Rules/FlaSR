8b544c86bfbb"],

Cell[TextData[{
 "To format and view the output, use the ",
 Cell[BoxData[
  RowBox[{"printSystem", "[", 
   RowBox[{"system", ",", " ", 
    RowBox[{"ampType", " ", "->", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "s"}], "}"}], " ", "OR", " ", 
      RowBox[{"{", "A", "}"}]}]}], ",", " ", 
    RowBox[{"amp2Type", " ", "->", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[CapitalDelta]", ",", "\[CapitalSigma]"}], "}"}], " ", "OR", 
      " ", 
      RowBox[{"{", "A", "}"}]}]}], ",", "..."}], "]"}]], "InlineCode",
  ExpressionUUID->"1045ac2f-c0ed-7842-a34c-96564b809a0f"],
 " function.\n\n",
 Cell[BoxData[
 "printSystem"], "InlineCode",ExpressionUUID->
  "e3d61d8c-75ed-2145-9461-ff0c8bd902b8"],
 " options: ",
 Cell[BoxData[
 "ampFormat"], "InlineCode",ExpressionUUID->
  "0d43553a-1bc2-9044-894e-a63406f3d356"],
 " (",
 Cell[BoxData[
 "String"], "InlineCode",ExpressionUUID->
  "ff8743d6-24ca-9c4a-a69a-fb972a364962"],
 "), ",
 Cell[BoxData[
 "expandSRs"], "InlineCode",ExpressionUUID->
  "e784a4bb-ca59-cf4d-b705-3108ff1d9a89"],
 " (",
 Cell[BoxData[
  RowBox[{"True", "|", "False"}]], "InlineCode",ExpressionUUID->
  "1ad1674c-5516-1f44-afe2-29e1463ce443"],
 "), ",
 Cell[BoxData[
 "CKM"], "InlineCode",ExpressionUUID->"1e6fa8f2-be49-9646-8a60-eca5614b292d"],
 " (",
 Cell[BoxData[
  RowBox[{"True", "|", "False"}]], "InlineCode",ExpressionUUID->
  "964258fb-ad11-6a46-8565-788a090290a1"],
