\[Eta]\), \(u\)]\) \!\(\*SuperscriptBox[\(K\), \(*\(0\)\)]\))" + 
      "A(\!\(\*SuperscriptBox[\(D\), \(0\)]\) \[Rule] \!\(\*SubscriptBox[\(\
\[Eta]\), \(u\)]\) \!\(\*SuperscriptBox[OverscriptBox[\(K\), \(_\)], \(*\(0\)\
\)]\))" + 
      "A(\!\(\*SuperscriptBox[\(D\), \(0\)]\) \[Rule] \
\!\(\*SuperscriptBox[\(K\), \(0\)]\) \!\(\*SubscriptBox[\(\[Phi]\), \
\(u\)]\))" - 
      "A(\!\(\*SuperscriptBox[\(D\), \(0\)]\) \[Rule] \
\!\(\*SuperscriptBox[\(K\), \(0\)]\) \
\!\(\*SuperscriptBox[OverscriptBox[\(K\), \(_\)], \(*\(0\)\)]\))" + 
      "A(\!\(\*SuperscriptBox[\(D\), \(0\)]\) \[Rule] \
\!\(\*SuperscriptBox[OverscriptBox[\(K\), \(_\)], \(0\)]\) \
\!\(\*SubscriptBox[\(\[Phi]\), \(u\)]\))" - 
      "A(\!\(\*SuperscriptBox[\(D\), \(0\)]\) \[Rule] \
\!\(\*SuperscriptBox[OverscriptBox[\(K\), \(_\)], \(0\)]\) \
\!\(\*SuperscriptBox[\(K\), \(*\(0\)\)]\))"}]]],
  Editable->False]], "Print",
 CellChangeTimes->{{3.9614560596829834`*^9, 3.9614560735193977`*^9}, {
